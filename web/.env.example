# คัดลอกไฟล์นี้เป็น .env (อย่า commit .env ตัวจริง)
# VITE_API_BASE_URL = URL ของ Apps Script Web App ที่ deploy แล้ว
#   (Deploy > New deployment > Web app แล้วคัดลอก URL ที่ลงท้ายด้วย /exec)
# VITE_API_TOKEN = ค่าเดียวกับที่ตั้งใน Script Properties > API_TOKEN (ดู apps-script/README.md)

VITE_API_BASE_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
VITE_API_TOKEN=change-me-to-a-long-random-string
